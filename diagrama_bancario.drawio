        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml Diagrama_Logico_Chen\nskinparam shadowing false\nskinparam roundcorner 6\nskinparam defaultTextAlignment center\n\n&#39; ENTIDADES (RECTÁNGULOS)\nrectangle \&quot;USUARIO\&quot; as USUARIO #E0F2FE\nrectangle \&quot;EMPRESA\&quot; as EMPRESA #DCFCE7\nrectangle \&quot;OFERTA_LABORAL\&quot; as OFERTA #FEF3C7\nrectangle \&quot;POSTULACION\&quot; as POSTULACION #F3E8FF\nrectangle \&quot;PERFIL_ACADEMICO\&quot; as ACADEMICO #E0E7FF\nrectangle \&quot;EXP_LABORAL\&quot; as EXP #FCE7F3\nrectangle \&quot;CURSO\&quot; as CURSO #FFEDD5\nrectangle \&quot;IDIOMA\&quot; as IDIOMA #F1F5F9\nrectangle \&quot;HABILIDAD\&quot; as HABILIDAD #F1F5F9\nrectangle \&quot;CIUDAD\&quot; as CIUDAD #F1F5F9\nrectangle \&quot;PROVINCIA\&quot; as PROVINCIA #F1F5F9\n\n&#39; ATRIBUTOS (ÓVALOS)\nusecase \&quot;&lt;u&gt;id_usuario&lt;/u&gt;\&quot; as U_PK\nusecase \&quot;nombre\&quot; as U_1\nusecase \&quot;apellido\&quot; as U_2\nusecase \&quot;correo\&quot; as U_3\nusecase \&quot;telefono\&quot; as U_4\nUSUARIO -- U_PK\nUSUARIO -- U_1\nUSUARIO -- U_2\nUSUARIO -- U_3\nUSUARIO -- U_4\n\nusecase \&quot;&lt;u&gt;id_empresa&lt;/u&gt;\&quot; as EMP_PK\nusecase \&quot;ruc\&quot; as EMP_1\nusecase \&quot;nombre_empresa\&quot; as EMP_2\nusecase \&quot;sitioweb\&quot; as EMP_3\nEMPRESA -- EMP_PK\nEMPRESA -- EMP_1\nEMPRESA -- EMP_2\nEMPRESA -- EMP_3\n\nusecase \&quot;&lt;u&gt;id_oferta&lt;/u&gt;\&quot; as OF_PK\nusecase \&quot;titulo\&quot; as OF_1\nusecase \&quot;descripcion\&quot; as OF_2\nusecase \&quot;salario_min\&quot; as OF_3\nusecase \&quot;salario_max\&quot; as OF_4\nusecase \&quot;vacantes\&quot; as OF_5\nusecase \&quot;fecha_cierre\&quot; as OF_6\nusecase \&quot;estado\&quot; as OF_7\nOFERTA -- OF_PK\nOFERTA -- OF_1\nOFERTA -- OF_2\nOFERTA -- OF_3\nOFERTA -- OF_4\nOFERTA -- OF_5\nOFERTA -- OF_6\nOFERTA -- OF_7\n\nusecase \&quot;&lt;u&gt;id_postulacion&lt;/u&gt;\&quot; as P_PK\nusecase \&quot;fecha_postulacion\&quot; as P_1\nusecase \&quot;estado\&quot; as P_2\nusecase \&quot;cv_url\&quot; as P_3\nusecase \&quot;match_ia\&quot; as P_4\nPOSTULACION -- P_PK\nPOSTULACION -- P_1\nPOSTULACION -- P_2\nPOSTULACION -- P_3\nPOSTULACION -- P_4\n\nusecase \&quot;&lt;u&gt;id_academico&lt;/u&gt;\&quot; as AC_PK\nusecase \&quot;titulo\&quot; as AC_1\nusecase \&quot;institucion\&quot; as AC_2\nACADEMICO -- AC_PK\nACADEMICO -- AC_1\nACADEMICO -- AC_2\n\nusecase \&quot;&lt;u&gt;id_exp&lt;/u&gt;\&quot; as EX_PK\nusecase \&quot;empresa\&quot; as EX_1\nusecase \&quot;cargo\&quot; as EX_2\nEXP -- EX_PK\nEXP -- EX_1\nEXP -- EX_2\n\nusecase \&quot;&lt;u&gt;id_curso&lt;/u&gt;\&quot; as CU_PK\nusecase \&quot;nombre_curso\&quot; as CU_1\nusecase \&quot;horas\&quot; as CU_2\nCURSO -- CU_PK\nCURSO -- CU_1\nCURSO -- CU_2\n\nusecase \&quot;&lt;u&gt;id_habilidad&lt;/u&gt;\&quot; as H_PK\nusecase \&quot;nombre\&quot; as H_1\nHABILIDAD -- H_PK\nHABILIDAD -- H_1\n\nusecase \&quot;&lt;u&gt;id_ciudad&lt;/u&gt;\&quot; as C_PK\nusecase \&quot;nombre_ciudad\&quot; as C_1\nusecase \&quot;&lt;u&gt;id_provincia&lt;/u&gt;\&quot; as PR_PK\nusecase \&quot;nombre_prov\&quot; as PR_1\nCIUDAD -- C_PK\nCIUDAD -- C_1\nPROVINCIA -- PR_PK\nPROVINCIA -- PR_1\n\n&#39; RELACIONES (ROMBOS) Y CARDINALIDADES\ndiamond \&quot;PUBLICA\&quot; as R_PUBLICA #BBF7D0\ndiamond \&quot;RECIBE\&quot; as R_RECIBE #DDD6FE\ndiamond \&quot;REALIZA\&quot; as R_REALIZA #DDD6FE\ndiamond \&quot;POSEE\&quot; as R_POSEE #C7D2FE\ndiamond \&quot;CUENTA_CON\&quot; as R_CUENTA #FBCFE8\ndiamond \&quot;ACREDITA\&quot; as R_ACREDITA #FED7AA\ndiamond \&quot;DOMINA\&quot; as R_DOMINA #E2E8F0\ndiamond \&quot;EXIGE\&quot; as R_EXIGE #FEF08A\ndiamond \&quot;UBICADA_EN\&quot; as R_UBICADA #E2E8F0\ndiamond \&quot;PERTENECE\&quot; as R_PERTENECE #E2E8F0\n\nEMPRESA \&quot;1\&quot; -- R_PUBLICA\nR_PUBLICA -- \&quot;N\&quot; OFERTA\n\nOFERTA \&quot;1\&quot; -- R_RECIBE\nR_RECIBE -- \&quot;N\&quot; POSTULACION\n\nUSUARIO \&quot;1\&quot; -- R_REALIZA\nR_REALIZA -- \&quot;N\&quot; POSTULACION\n\nUSUARIO \&quot;1\&quot; -- R_POSEE\nR_POSEE -- \&quot;N\&quot; ACADEMICO\n\nUSUARIO \&quot;1\&quot; -- R_CUENTA\nR_CUENTA -- \&quot;N\&quot; EXP\n\nUSUARIO \&quot;1\&quot; -- R_ACREDITA\nR_ACREDITA -- \&quot;N\&quot; CURSO\n\nUSUARIO \&quot;N\&quot; -- R_DOMINA\nR_DOMINA -- \&quot;M\&quot; IDIOMA\n\nOFERTA \&quot;N\&quot; -- R_EXIGE\nR_EXIGE -- \&quot;M\&quot; HABILIDAD\n\nOFERTA \&quot;N\&quot; -- R_UBICADA\nR_UBICADA -- \&quot;1\&quot; CIUDAD\n\nCIUDAD \&quot;N\&quot; -- R_PERTENECE\nR_PERTENECE -- \&quot;1\&quot; PROVINCIA\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="f2JNV9kb6bc3Icj9nQsH-1">
